// Speshell configuration
// Location: ~/.config/speshell/config.jsonc
// Edit this file, then use Settings → Reload. Every property is optional.
{
  // Appearance
  // Schemes: gruvbox, catppuccin-{mocha,macchiato,frappe,latte},
  // nord, dracula, tokyo-night, rose-pine,
  // solarized-dark, and everforest.
  "colorScheme": "gruvbox",

  // Surface
  // Keep panelWorkspace in sync with the Hyprland special-workspace rule.
  // Width: 240-1200. Margin: 0-128.
  "panelWorkspace": "special:term",
  "panelWidth": 420,
  "panelMargin": 16,

  // Launcher
  // Search URLs must use HTTPS and contain exactly one {query} placeholder.
  // Bang names use lowercase letters, digits, or hyphens.
  "launcher": {
    "width": 540,
    "visibleRows": 5,
    "searchUrl": "https://duckduckgo.com/?q={query}",
    "bangs": {
      "gh": "https://github.com/search?q={query}",
      "yt": "https://www.youtube.com/results?search_query={query}"
    }
  },

  // Audio
  // Quick-switch entries match substrings in device names. Display-name maps
  // accept either the PipeWire/Pulse name or description as their keys.
  // Discover them with `pactl list sinks` and `pactl list sources`.
  // Empty quick-switch arrays show every available device.
  "audioQuickSwitch": [],
  "audioDeviceNames": {},
  "audioInputQuickSwitch": [],
  "audioInputDeviceNames": {},

  // Backlight
  // Leave empty to use the first entry under /sys/class/backlight.
  "backlightDevice": "",

  // Power
  // The locker must remain running for the duration of the locked session.
  "powerMenu": {
    "lockCommand": ["hyprlock"]
  },

  // Weather
  // Weather is opt-in. An empty location lets wttr.in infer it from the request.
  "weatherEnabled": false,
  "weatherLocation": "",

  // Notifications
  // Use -1 for every stored notification, or a value from 1 to 50.
  "maxVisibleNotification": 3
}
